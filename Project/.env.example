# docker-compose.yml에서 사용하는 환경변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값을 채워넣으세요. (.env는 git에 커밋하지 마세요)

# 외부 MySQL 접속 정보 (localhost 아님 - docker-compose 컨테이너 밖에 있는 실제 DB 호스트)
DB_URL=jdbc:mysql://your-db-host:3306/roomie_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=roomie
DB_PASSWORD=change-me

# JWT 서명 키 (32바이트 이상 랜덤 문자열로 교체)
JWT_SECRET=change-me-to-a-long-random-secret

# 프론트에서 접속을 허용할 origin (nginx가 같은 origin으로 프록시하므로 보통 안 씀)
CORS_ALLOWED_ORIGINS=http://localhost:5174

# 프론트(nginx)를 호스트의 몇 번 포트로 열지
FRONTEND_PORT=80
